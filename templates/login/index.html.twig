{% extends 'base.html.twig' %}

{% block body %}
    <div class="my-5">
        <h1 class="mb-4">Connexion Admin</h1>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post">
            <div class="mb-3">
                <label for="username" class="form-label">Votre email :</label>
                <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}">
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Votre mot de passe :</label>
                <input class="form-control" type="password" id="password" name="_password">
            </div>

            <input type="hidden" name="_target_path" value="/admin">

            <button type="submit" class="btn btn-success mt-2">Me connecter</button>
        </form>

        <div class="mt-3">
            <a href="{{ path('app_password') }}">Mot de passe oublié ?</a>
        </div>
    </div>
{% endblock %}
